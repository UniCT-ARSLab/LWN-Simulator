{
  "name": "@lwn-simulator/ui-components",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./scss/*": "./dist/scss/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build:ts": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:css": "sass src/styles/main.scss dist/styles.css --no-source-map",
    "build:scss": "shx mkdir -p dist/scss && shx cp src/styles/breakpoints.scss src/styles/fonts.scss dist/scss",
    "build:types": "shx mkdir -p dist/types && shx cp -r src/types/* dist/types",
    "build": "yarn clean && yarn build:ts && yarn build:css && yarn build:scss && yarn build:types",
    "lint:ts": "eslint",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "storybook": "npx storybook dev -p 6006",
    "build-storybook": "npx storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "peerDependencies": {
    "@lwn-simulator/contracts": "workspace:*",
    "@lwn-simulator/sdk": "workspace:*",
    "material-symbols": "^0.45.9",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.5.5",
    "@storybook/nextjs-vite": "^10.5.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-storybook": "^10.5.4",
    "jsdom": "^26.1.0",
    "react": "19.2.4",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "19.2.4",
    "react-toastify": "^11.1.0",
    "sass": "^1.102.0",
    "shx": "^0.4.0",
    "storybook": "^10.5.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^5",
    "vite": "^8.1.5",
    "vitest": "^3.2.4"
  }
}
